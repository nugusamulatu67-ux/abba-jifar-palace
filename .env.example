# Copy this file to .env in the repository root:
#   copy .env.example .env
#
# Put real secrets only in .env. That file is gitignored.

# API port
PORT=4000

# development | test | production
NODE_ENV=development

# Browser origin allowed to call the API directly.
# The Vite dev server proxies /api, so the placeholder page does not need this for local development.
CLIENT_ORIGIN=http://localhost:5173

# SQLite file. Relative paths are resolved from the repository root.
# The file is created on first connection and is not committed.
DATABASE_PATH=database/dev.sqlite

# Authentication is a later phase. When that work starts, set a long random value here.
# JWT_SECRET=replace-with-a-long-random-string
