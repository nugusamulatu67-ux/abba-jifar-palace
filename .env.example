# Copy this file to .env in the repository root:
#   copy .env.example .env
#
# Put real local passwords only in .env. That file is gitignored.

# API port
PORT=4000

# development | test | production
NODE_ENV=development

# Browser origin allowed to call the API directly.
# The Vite dev server proxies /api, so the placeholder page does not need this for local development.
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection. The password here must match the cluster you start.
# npm run db:up creates a project-local cluster on port 5433 when this URL cannot connect.
DATABASE_URL=postgresql://abba_jifar:replace-with-a-local-database-password@127.0.0.1:5433/abba_jifar

# Development administrator created by npm run db:seed.
# Use a local password of at least 8 characters. Do not reuse a production password.
SEED_ADMIN_EMAIL=admin@abba-jifar.local
SEED_ADMIN_PASSWORD=replace-with-a-local-dev-password

# Authentication is a later phase. When that work starts, set a long random value here.
# JWT_SECRET=replace-with-a-long-random-string
